  "components": {
    "schemas": {
      "AcomodacaoResponseSchema": {
        "properties": {
          "uuid_publico": {
            "type": "string",
            "title": "Uuid Publico"
          },
          "numero": {
            "type": "string",
            "title": "Numero"
          },
          "categoria": {
            "type": "string",
            "title": "Categoria"
          },
          "capacidade": {
            "type": "integer",
            "title": "Capacidade"
          },
          "tarifa_base": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Tarifa Base"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "andar": {
            "type": "integer",
            "title": "Andar"
          },
          "descricao": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Descricao"
          },
          "hospedagem_ativa": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hospedagem Ativa"
          }
        },
        "type": "object",
        "required": [
          "uuid_publico",
          "numero",
          "categoria",
          "capacidade",
          "tarifa_base",
          "status",
          "andar"
        ],
        "title": "AcomodacaoResponseSchema"
      },
      "AcomodacaoStatusUpdateSchema": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Novo status: DISPONIVEL, OCUPADO, MANUTENCAO, LIMPEZA"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AcomodacaoStatusUpdateSchema"
      },
      "CargoEnum": {
        "type": "string",
        "enum": [
          "ADMIN",
          "GERENTE",
          "FUNCIONARIO"
        ],
        "title": "CargoEnum"
      },
      "CheckinRequestSchema": {
        "properties": {
          "uuid_hospede": {
            "type": "string",
            "title": "Uuid Hospede",
            "description": "UUID público do hóspede cadastrado"
          },
          "uuid_acomodacao": {
            "type": "string",
            "title": "Uuid Acomodacao",
