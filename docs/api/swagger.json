{
  "openapi": "3.1.0",
  "info": {
    "title": "Grand Plaza Hotel Management API — Gestão de Usuários",
    "description": "API REST corporativa para autenticação, controle de permissões RBAC e gestão segura de operadores do hotel.",
    "version": "1.3.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Autenticação do Operador",
        "description": "Autentica o operador, verifica o hash Bcrypt e emite um HttpOnly Cookie.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Encerramento de Sessão",
        "description": "Invalida a sessão ativa no banco de dados e expira o cookie.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Dados da Sessão Ativa (Para a Topbar)",
        "description": "Retorna o perfil e nível do operador autenticado para renderização na topbar.",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Status do Sistema e Diagnóstico do Banco de Dados",
        "description": "Retorna o diagnóstico de conectividade com o banco de dados (Supabase PostgreSQL vs Fallback).",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/operadores": {
      "post": {
        "tags": [
          "Usuários do Sistema"
        ],
        "summary": "Cadastro de Novo Operador do Sistema",
        "description": "Cadastra um novo usuário do sistema com nível hierárquico (ADMIN, GERENTE, FUNCIONARIO).\nAcesso restrito ao Administrador.",
        "operationId": "cadastrar_operador_api_v1_operadores_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperadorCreateSchema"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Usuários do Sistema"
        ],
        "summary": "Listagem de Usuários do Sistema",
        "description": "Retorna a lista de colaboradores e operadores cadastrados no sistema com filtros.",
        "operationId": "listar_operadores_api_v1_operadores_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "cargo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cargo"
            }
          },
          {
            "name": "status_filtro",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status Filtro"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operadores/{operador_uuid}": {
      "put": {
        "tags": [
          "Usuários do Sistema"
        ],
        "summary": "Atualização Cadastral de Operador",
        "description": "Atualiza dados do operador (Nome, E-mail, Cargo e opcionalmente nova Senha).\nAcesso restrito ao Administrador.",
        "operationId": "atualizar_operador_api_v1_operadores__operador_uuid__put",
        "parameters": [
          {
            "name": "operador_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Operador Uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperadorUpdateSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operadores/{operador_uuid}/status": {
      "patch": {
        "tags": [
          "Usuários do Sistema"
        ],
        "summary": "Alternar Status de Operador (Soft Delete)",
        "description": "Ativa ou desativa a conta de um operador de forma lógica.\nAcesso restrito ao Administrador.",
        "operationId": "alternar_status_operador_api_v1_operadores__operador_uuid__status_patch",
        "parameters": [
          {
            "name": "operador_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Operador Uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperadorStatusSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hospedes": {
      "get": {
        "tags": [
          "Hóspedes"
        ],
        "summary": "Listagem de Hóspedes",
        "operationId": "listar_hospedes_api_v1_hospedes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/export-swagger-json": {
      "get": {
        "tags": [
          "Documentação"
        ],
        "summary": "Exporta o contrato OpenAPI para docs/api/swagger.json",
        "description": "Gera o arquivo docs/api/swagger.json com todos os endpoints do RF-003.",
        "operationId": "exportar_swagger_json_export_swagger_json_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Frontend"
        ],
        "summary": "Página Principal SPA",
        "operationId": "get_index__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/app.js": {
      "get": {
        "tags": [
          "Frontend"
        ],
        "summary": "Script Cliente da SPA",
        "operationId": "get_app_js_app_js_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CargoEnum": {
        "type": "string",
        "enum": [
          "ADMIN",
          "GERENTE",
          "FUNCIONARIO"
        ],
        "title": "CargoEnum",
        "description": "Enumeração formal dos três níveis de privilégio permitidos no sistema."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginSchema": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "E-mail institucional do colaborador"
          },
          "senha": {
            "type": "string",
            "maxLength": 100,
            "minLength": 6,
            "title": "Senha",
            "description": "Senha de acesso em texto para validação contra o hash Bcrypt"
          }
        },
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "title": "LoginSchema",
        "description": "Payload de entrada para o endpoint de autenticação do operador."
      },
      "OperadorCreateSchema": {
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Nome",
            "description": "Nome completo do colaborador"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "E-mail corporativo institucional único (RFC 5322)"
          },
          "senha": {
            "type": "string",
            "maxLength": 100,
            "minLength": 6,
            "title": "Senha",
            "description": "Senha temporária ou definitiva de acesso"
          },
          "confirmacao_senha": {
            "type": "string",
            "maxLength": 100,
            "minLength": 6,
            "title": "Confirmacao Senha",
            "description": "Confirmação idêntica da senha"
          },
          "cargo": {
            "$ref": "#/components/schemas/CargoEnum",
            "description": "Nível de acesso hierárquico: ADMIN, GERENTE ou FUNCIONARIO"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "email",
          "senha",
          "confirmacao_senha",
          "cargo"
        ],
        "title": "OperadorCreateSchema",
        "description": "Payload de entrada para cadastro de novos usuários do sistema (RF-003).\nAcesso restrito ao Administrador do Sistema."
      },
      "OperadorStatusSchema": {
        "properties": {
          "is_ativo": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Is Ativo",
            "description": "Status do cadastro: 1 = Ativo, 0 = Inativo (Bloqueio de acesso)"
          }
        },
        "type": "object",
        "required": [
          "is_ativo"
        ],
        "title": "OperadorStatusSchema",
        "description": "Payload de entrada para alternância de status ativo/inativo (Soft Delete)."
      },
      "OperadorUpdateSchema": {
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Nome",
            "description": "Nome completo do colaborador"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "E-mail corporativo atualizado"
          },
          "cargo": {
            "$ref": "#/components/schemas/CargoEnum",
            "description": "Nível de acesso hierárquico atualizado: ADMIN, GERENTE ou FUNCIONARIO"
          },
          "senha": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 6
              },
              {
                "type": "null"
              }
            ],
            "title": "Senha",
            "description": "Nova senha (opcional)"
          },
          "confirmacao_senha": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 6
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmacao Senha",
            "description": "Confirmação da nova senha"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "email",
          "cargo"
        ],
        "title": "OperadorUpdateSchema",
        "description": "Payload de entrada para atualização de dados de operador existente.\nAcesso restrito ao Administrador."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}